//广州A1

spriteset (spriteset_guangzhou_b1_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("guangzhou_metro", "guangzhou-b1-c-1")
}
// Vehicle
spriteset (spriteset_guangzhou_b1_cp_1, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("guangzhou_metro", "guangzhou-b1-c-1")
}
spriteset (spriteset_guangzhou_b1_cp_2, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_reversed_9 ("guangzhou_metro", "guangzhou-b1-c-2")
}
spriteset (spriteset_guangzhou_b1_t, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("guangzhou_metro", "guangzhou-b1-t")
}


switch (FEAT_TRAINS, SELF, switch_guangzhou_b1_articulated_part, extra_callback_info1) {
    1..8: return guangzhou_b1;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, guangzhoub1, vehicle_type_id) {
    guangzhou_b1: return onlyallowcst;
    return CB_RESULT_ATTACH_DISALLOW;
}


//编组

switch (FEAT_TRAINS, SELF, switch_guangzhou_b1_graphics, position_in_articulated_veh){
    1: spriteset_guangzhou_b1_cp_1;
    4: spriteset_guangzhou_b1_t;
    7: spriteset_guangzhou_b1_cp_2;
    empty_sprites;
}


//载客
switch (FEAT_TRAINS, SELF, switch_guangzhou_b1_capacity, position_in_articulated_veh % 3) {
    1: return 250;
    return 0;
}


//属性
item (FEAT_TRAINS, guangzhou_b1) {
    property {
        // Menu
        name:                           string(STR_NAME_GUANGZHOU_B1);
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_MU);
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        variant_group:					guangzhou_a1;


        // Availability
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2005,11,01);
        model_life:                     80;
        retire_early:                   40;
        vehicle_life:                   50;
        track_type:                     SABd;

        // Cargo
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes:   0;
        cargo_allow_refit:              [PASS, TOUR, YETI, YETY];
        cargo_disallow_refit:           [];
        refit_cost:                     0;
        default_cargo_type:             PASS;
        ai_special_flag:                AI_FLAG_PASSENGER;
        cargo_capacity:                 1;
        loading_speed:                  70;
        cargo_age_period:               120<< param_cargo_decay;

        // Stats
        speed:                          120 km/h;
        power:                          3680 kW;
        weight:                         90 ton;
        tractive_effort_coefficient:    0.0867;
        cost_factor:                    25;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        running_cost_factor:            12;
        reliability_decay:              10;
    }
    graphics {
        // Menu
        additional_text:                string(STR_DESC_6, string(STR_USEDLINE_GZ_B1), string(STR_ELECTRIC_1500VDC), string(STR_3B_WAGON), string(STR_COMFORT_LOW, 128), string(STR_RELDEC_LOW));
        can_attach_wagon:               guangzhoub1;
        start_stop:                     mu3to6car;
        // Graphics
        default:                        switch_guangzhou_b1_graphics;
        purchase:                       spriteset_guangzhou_b1_purchase;
        articulated_part:               switch_guangzhou_b1_articulated_part;
        name:                           switch_guangzhou_name;


        // Stats
        length:                         switch_length_2_5_2;
        cargo_capacity:                 switch_guangzhou_b1_capacity;
        purchase_cargo_capacity:        250/3;
        cargo_age_period:               128<< param_cargo_decay;
        cost_factor:                    32;
        purchase_running_cost_factor:   28;
        running_cost_factor:            28;
    }
}